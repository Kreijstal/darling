# Configure-only controls for the production readiness helper. No SDK inputs or
# production compilation are required; generated paths are checked without printing
# generated commands.
if(NOT DARLING_SOURCE OR NOT TEST_BINARY_ROOT)
    message(FATAL_ERROR "DARLING_SOURCE and TEST_BINARY_ROOT are required")
endif()
get_filename_component(DARLING_SOURCE "${DARLING_SOURCE}" ABSOLUTE)
get_filename_component(TEST_BINARY_ROOT "${TEST_BINARY_ROOT}" ABSOLUTE)
file(MAKE_DIRECTORY "${TEST_BINARY_ROOT}/fixture")
file(WRITE "${TEST_BINARY_ROOT}/fixture/empty.c" "int network_fixture;\n")
file(WRITE "${TEST_BINARY_ROOT}/fixture/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.13)
project(NetworkReadiness C)
list(APPEND CMAKE_MODULE_PATH "${DARLING_SOURCE}/cmake")
include(darling_swift)
function(native_target)
    add_library(Network SHARED empty.c)
endfunction()
function(swift_target)
    add_library(swiftNetwork SHARED empty.c)
endfunction()
if(CASE STREQUAL "native-first")
    native_target()
    darling_register_network_swift_reexport()
    swift_target()
elseif(CASE STREQUAL "swift-first")
    swift_target()
    darling_register_network_swift_reexport()
    native_target()
elseif(CASE STREQUAL "no-toolchain" OR CASE STREQUAL "32-bit")
    native_target()
    if(CASE STREQUAL "32-bit")
        set(SWIFT_TOOLCHAIN_FOUND TRUE)
        set(BUILD_TARGET_64BIT FALSE)
        add_darling_swift_library(Network SOURCES absent.swift)
    else()
        # The SDK overlay caller is skipped when toolchain discovery fails.
        set(SWIFT_TOOLCHAIN_FOUND FALSE)
        set(BUILD_TARGET_64BIT TRUE)
    endif()
elseif(CASE STREQUAL "no-native")
    swift_target()
else()
    message(FATAL_ERROR "unknown fixture case")
endif()
darling_register_network_swift_reexport()
darling_register_network_swift_reexport()
if(CASE STREQUAL "native-first" OR CASE STREQUAL "swift-first")
    get_property(marker TARGET Network PROPERTY DARLING_SWIFT_NETWORK_REEXPORT_REGISTERED)
    get_property(deps TARGET Network PROPERTY MANUALLY_ADDED_DEPENDENCIES)
    get_property(options TARGET Network PROPERTY LINK_OPTIONS)
    get_property(flags TARGET Network PROPERTY LINK_FLAGS)
    if(NOT marker OR NOT deps STREQUAL "swiftNetwork")
        message(FATAL_ERROR "source target dependency not registered once")
    endif()
    string(REGEX MATCHALL "reexport_library" matches "${options}${flags}")
    list(LENGTH matches count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "reexport registration not idempotent")
    endif()
else()
    if(TARGET Network)
        get_property(marker TARGET Network PROPERTY DARLING_SWIFT_NETWORK_REEXPORT_REGISTERED)
        get_property(deps TARGET Network PROPERTY MANUALLY_ADDED_DEPENDENCIES)
        if(marker OR deps OR TARGET swiftNetwork)
            message(FATAL_ERROR "unavailable Swift provider registered")
        endif()
    endif()
endif()
]=])
foreach(case native-first swift-first no-toolchain 32-bit no-native)
    set(binary "${TEST_BINARY_ROOT}/${case}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -G Ninja
        -S "${TEST_BINARY_ROOT}/fixture" -B "${binary}"
        "-DDARLING_SOURCE=${DARLING_SOURCE}" "-DCASE=${case}"
        RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "readiness fixture ${case} failed")
    endif()
    if(case STREQUAL "native-first" OR case STREQUAL "swift-first")
        file(READ "${binary}/build.ninja" graph)
        string(FIND "${graph}" "-reexport_library,${binary}/libswiftNetwork" resolved)
        string(FIND "${graph}" "$<TARGET_FILE:swiftNetwork>" unresolved)
        if(resolved EQUAL -1 OR NOT unresolved EQUAL -1)
            message(FATAL_ERROR "source target reexport did not resolve")
        endif()
    endif()
endforeach()

# Exercise both existing provider profiles, retaining their exact source lists.
set(OVERLAYS "${DARLING_SOURCE}/src/external/swift/overlays")
set(TARGET_ARM64 TRUE)
set(DARLING_SWIFT_NETWORK_PROVIDER socket CACHE STRING "" FORCE)
include("${OVERLAYS}/Network/source-provider.cmake")
list(LENGTH NETWORK_SOURCES count)
if(NOT count EQUAL 6)
    message(FATAL_ERROR "socket provider selection changed")
endif()
foreach(source IN LISTS NETWORK_SOURCES)
    if(NOT EXISTS "${source}" OR source MATCHES "/NW[A-Z]")
        message(FATAL_ERROR "socket source list is mixed or absent")
    endif()
endforeach()
set(DARLING_SWIFT_NETWORK_PROVIDER canonical CACHE STRING "" FORCE)
include("${OVERLAYS}/Network/source-provider.cmake")
list(LENGTH NETWORK_SOURCES count)
if(NOT count EQUAL 12 OR NETWORK_PROVIDER_FLAGS)
    message(FATAL_ERROR "canonical provider selection changed")
endif()
foreach(source IN LISTS NETWORK_SOURCES)
    if(NOT EXISTS "${source}")
        message(FATAL_ERROR "canonical source is absent")
    endif()
endforeach()
